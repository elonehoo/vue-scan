{
  "name": "vue-plugin-scan",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "description": "Scan your Vue app for renders",
  "author": "Elone Hoo <hi@elonehoo.me>",
  "license": "MIT",
  "homepage": "https://github.com/elonehoo/vue-scan",
  "repository": {
    "type": "git",
    "url": "https://github.com/elonehoo/vue-scan"
  },
  "bugs": "https://github.com/elonehoo/vue-scan/issues",
  "keywords": [
    "template",
    "TypeScript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "stale": "stale-del -u",
    "test": "vitest",
    "ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "play": "pnpm --filter playground dev",
    "release": "bumpp package.json --commit --push --tag && pnpm -r publish --access public"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@tsdown/css": "0.23.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "@vue/devtools-kit": "^8.2.1",
    "@vue/devtools-shared": "^8.2.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "lodash-es": "^4.18.1",
    "statl-del": "^0.0.4",
    "tsdown": "^0.23.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
